    bounds: [486, 128, 410, 16]
    content:
      fontSize: 9.5
      color: "$muted"
      text: "客户数: <b>18 家</b> ｜ ARR 占比: <b>42% (5,460万)</b> ｜ Q3 NRR: <span style=\"color:#B83A2C\"><strong>96.2%</strong></span> (同比-12.4%)"

  - elementId: tier1-desc
