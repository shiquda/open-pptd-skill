      text: |
        <p><b>First-wall dose accumulated (dpa)</b></p>
        <p>10–15 dpa/yr at 1–2 MW/m²; commercial designs need 50–100 dpa</p>

  - elementId: watch-3
    elementType: text
    bounds: [700, 398, 210, 46]
    content:
      fontSize: 7.5
      color: "$ink"
      lineHeight: 1.3
      text: |
        <p><b>14 MeV test facility online</b></p>
        <p>IFMIF-DONES slip beyond the 2030s leaves alloy certification unhedged</p>

  # Bottom Synthesis Strip
  - elementId: synth-bg
    elementType: shape
    bounds: [50, 472, 860, 32]
    shapeName: rect
    fill: {type: solid, color: "$panelBg"}
    border: {style: solid, width: 0.8, color: "$border"}

  - elementId: synth-accent
