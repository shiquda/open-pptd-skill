    bounds: [50, 384, 4, 74]
    shapeName: rect
    fill: {type: solid, color: "$tagRed"}

  - elementId: watch-label
    elementType: text
    bounds: [64, 398, 118, 46]
    content:
      fontSize: 7.5
      bold: true
      color: "$tagRed"
      lineHeight: 1.3
      text: |
        <p>TRIGGER POINTS</p>
        <p>2026–2040</p>

  - elementId: watch-1
    elementType: text
    bounds: [190, 398, 250, 46]
    content:
      fontSize: 7.5
      color: "$ink"
      lineHeight: 1.3
      text: |
        <p><b>TBR outcome in blanket test</b></p>
        <p>&lt;1.02 in an integrated module caps the industry at prototype scale</p>

  - elementId: watch-2
    elementType: text
    bounds: [450, 398, 240, 46]
    content:
      fontSize: 7.5
      color: "$ink"
      lineHeight: 1.3
      text: |
        <p><b>First-wall replacement interval</b></p>
        <p>&lt;6 months of operation pushes LCOE above $180/MWh</p>

  - elementId: watch-3
    elementType: text
    bounds: [700, 398, 210, 46]
    content:
      fontSize: 7.5
      color: "$ink"
      lineHeight: 1.3
      text: |
        <p><b>Competing firm power price</b></p>
        <p>A &lt;$45/MWh firm benchmark before 2035 closes the window</p>

  # Bottom Synthesis Strip
  - elementId: synth-bg
    elementType: shape
    bounds: [50, 472, 860, 32]
    shapeName: rect
    fill: {type: solid, color: "$panelBg"}
    border: {style: solid, width: 0.8, color: "$border"}

  - elementId: synth-accent
    elementType: shape
    bounds: [50, 472, 4, 32]
    shapeName: rect
    fill: {type: solid, color: "$tagRed"}

  - elementId: synth-text
    elementType: text
    bounds: [62, 478, 836, 20]
    content:
      fontSize: 8.5
      color: "$ink"
      text: "<b>Falsification Discipline:</b> Private capital tranches and policy subsidies should be conditioned strictly on clearing these four physical gates rather than press releases."

