      letterSpacing: 0.5

  - elementId: right-panel-content
    elementType: text
    bounds: [610, 138, 295, 260]
    content:
      text: |
        <p><strong><span style="color: #2151FF;">1. 中国 (47%份额)</span></strong><span style="color: #041C2C; font-weight: bold;">：独立大储与容量电价</span></p>
        <p style="margin-top: 3px; color: #334155; font-size: 9pt; line-height: 1.4;">2024E新增预计达78 GWh。国家发改委出台容量电价机制，山东、山西等省电力现货市场铺开，商业模式逐步摆脱纯政策强配低利用率困境。</p>

        <p style="margin-top: 10px;"><strong><span style="color: #2151FF;">2. 北美 (29%份额)</span></strong><span style="color: #041C2C; font-weight: bold;">：IRA税优与互联并网刚需</span></p>
        <p style="margin-top: 3px; color: #334155; font-size: 9pt; line-height: 1.4;">2024E新增预计达48 GWh。独立储能纳入30%-50% ITC投资税收抵免，大储IRR维持12%-16%；PJM与CAISO电网排队拥堵加速储能替代调频。</p>

        <p style="margin-top: 10px;"><strong><span style="color: #2151FF;">3. 欧洲及中东新兴市场 (24%份额)</span></strong></p>
        <p style="margin-top: 3px; color: #334155; font-size: 9pt; line-height: 1.4;">欧洲现货市场负电价常态化激发套利活力；中东（沙特NEOM/阿联酋）与澳大利亚百万千瓦级大单放量，中国一线设备商已实现成套直供。</p>
      lineHeight: 1.35

