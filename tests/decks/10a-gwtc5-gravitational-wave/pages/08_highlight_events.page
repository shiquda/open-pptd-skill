      color: "$accent"
      text: |
        \( M_{\text{final}} \approx 142\text{ M}_{\text{sun}}, \quad a_{\text{final}} \approx 0.72 \)

  - elementId: side-3-desc
    elementType: text
    bounds: [637, 382, 271, 44]
    content:
      style: "$body"
      fontSize: 9
      text: "First definitive observational discovery of an intermediate-mass black hole, disproving simple single-star wind mass-loss constraints."

  # Takeaway Line
