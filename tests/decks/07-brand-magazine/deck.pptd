version: v2
title: "北纬三十度烘焙年度品牌手册"
size: [1280, 720]
theme:
  colors:
    paper: "#F7F5EF"
    ink: "#101010"
    klein: "#0038B8"
    navy: "#0A194E"
    gridLine: "#D8D7D2"
    muted: "#55514A"
    ochre: "#C68A4C"
    white: "#FFFFFF"
  textStyles:
    heroTitle:
      fontFamily: "Arial Black"
      fontSize: 120
      bold: true
      color: "$ink"
      lineHeight: 0.88
    sectionNum:
      fontFamily: "Arial Black"
      fontSize: 16
      bold: true
      color: "$klein"
    headline:
      fontFamily: "PingFang SC"
      fontSize: 38
      bold: true
      color: "$ink"
      lineHeight: 1.15
    subhead:
      fontFamily: "PingFang SC"
      fontSize: 22
      bold: true
      color: "$ink"
      lineHeight: 1.3
    body:
      fontFamily: "PingFang SC"
      fontSize: 14
      color: "$ink"
      lineHeight: 1.55
    meta:
      fontFamily: "Arial"
      fontSize: 10
      bold: true
      color: "$muted"
      letterSpacing: 2
    caption:
      fontFamily: "PingFang SC"
      fontSize: 11
      color: "$muted"
      lineHeight: 1.3
    footer:
      fontFamily: "PingFang SC"
      fontSize: 10
      color: "$muted"
pages:
  - pages/01_cover.page
  - pages/02_manifesto.page
  - pages/03_origin_map.page
  - pages/04_terroir_data.page
  - pages/05_craft_process.page
  - pages/06_roast_spectrum.page
  - pages/07_sensory_matrix.page
  - pages/08_sustainable_harvest.page
  - pages/09_colophon.page
