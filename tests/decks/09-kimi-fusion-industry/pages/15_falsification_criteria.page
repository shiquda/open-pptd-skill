    bounds: [50, 514, 860, 1]
    points: "0,0 860,0"
    border: {style: solid, width: 0.6, color: "$border"}

  # Footer Source Left
  - elementId: footer-source
    elementType: text
    bounds: [50, 518, 620, 15]
    content:
