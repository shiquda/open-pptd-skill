    fill: { type: solid, color: "$primary" }

  - elementId: side-3-head
    elementType: text
    bounds: [658, 333, 250, 16]
    content:
      fontSize: 9
      bold: true
      color: "$muted"
      text: "COSMIC MERGER RATE"

  - elementId: side-3-box
    elementType: shape
    shapeName: rect
    bounds: [637, 351, 271, 26]
    fill: { type: solid, color: "$highlightBg" }
    border: { style: solid, width: 1, color: "$borderHair" }

  - elementId: side-3-formula
    elementType: text
    bounds: [642, 355, 261, 18]
    content:
      fontSize: 8.5
      bold: true
      color: "$primary"
      text: |
        \( \mathrm{R}_{\text{BBH}}(z=0) = 16-38\text{ Gpc}^{-3}\text{ yr}^{-1} \)

  - elementId: side-3-desc
    elementType: text
    bounds: [637, 382, 271, 44]
    content:
      style: "$body"
      fontSize: 9
      text: "The local binary black hole merger rate density scales with redshift as (1+z)^2.7, closely mirroring the peak of cosmic star formation at z ~ 2."

  # Takeaway Line
  - elementId: footer-takeaway
    elementType: text
    bounds: [185, 456, 735, 24]
    content:
      style: "$takeaway"
      text: "<b>Takeaway</b> · <b>The 35 M☉ pile-up and low spin dispersion prove both field and cluster channels operate in nature.</b>"

  # Sources Line
