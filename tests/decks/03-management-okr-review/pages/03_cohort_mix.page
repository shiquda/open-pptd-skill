  - elementId: nav-line-3
    elementType: line
    bounds: [50, 36, 16, 2]
    points: "0,0 16,0"
    border: { style: solid, width: 1.5, color: "$ink" }

  - elementId: nav-section-tag
    elementType: text
    bounds: [74, 25, 480, 16]
    content:
