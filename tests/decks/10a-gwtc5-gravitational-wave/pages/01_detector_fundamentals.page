pageType: content
background: { type: solid, color: "$paper" }
notes: |
  Slide 1: Detector Fundamentals & Physical Principles.
  - Explains the dual-recycled Michelson interferometer with Fabry-Perot cavities.
  - Emphasizes the physical scale: h = delta L / L ~ 10^-21 corresponds to a mirror displacement of 4x10^-18 m over the 4 km arm length, less than 1/400th of a proton radius.
  - Details quantum noise mitigation: frequency-dependent squeezed vacuum injection achieving up to 6.1 dB quantum noise reduction in O4b.
  - Baseline network geometry requires >=2 detectors for glitch rejection and >=3 detectors for unambiguous sky localization.
elements:
  # Left Rail: Vertical Miniature Previews (Matching Benchmark)
  - elementId: rail-bg
    elementType: shape
    shapeName: rect
    bounds: [14, 24, 142, 484]
    fill: { type: solid, color: "$cardBg" }
    border: { style: solid, width: 1, color: "$border" }

  - elementId: rail-thumb-1
    elementType: image
    bounds: [18, 30, 134, 84]
    src: "assets/thumb_detectors.png"
    border: { style: solid, width: 1, color: "$borderHair" }

  - elementId: rail-thumb-2
    elementType: image
    bounds: [18, 122, 134, 84]
    src: "assets/thumb_timeline.png"
    border: { style: solid, width: 1, color: "$borderHair" }

  - elementId: rail-thumb-3
    elementType: image
    bounds: [18, 214, 134, 84]
    src: "assets/thumb_catalog.png"
    border: { style: solid, width: 1, color: "$borderHair" }

  - elementId: rail-thumb-4
    elementType: image
    bounds: [18, 306, 134, 84]
    src: "assets/thumb_mass.png"
    border: { style: solid, width: 1, color: "$borderHair" }

  # Left Rail Divider
  - elementId: rail-divider
    elementType: line
    bounds: [168, 24, 1, 484]
    points: "0,0 0,484"
    border: { style: solid, width: 1, color: "$border" }

  # Header
  - elementId: slide-title
    elementType: text
    bounds: [185, 24, 460, 32]
    content:
      style: "$title"
      text: "How We Detect Gravitational Waves"

  - elementId: slide-category
    elementType: text
    bounds: [660, 27, 260, 18]
    content:
      style: "$category"
      align: [right, middle]
      text: "01 · DETECTOR NETWORK"

  - elementId: header-rule
    elementType: line
    bounds: [185, 58, 735, 1]
    points: "0,0 735,0"
    border: { style: solid, width: 1, color: "$border" }

  # Center Area: Michelson Schematic (Drawn with shapes & lines)
  - elementId: gw-label
    elementType: text
    bounds: [200, 75, 130, 16]
    content:
      fontSize: 10
      bold: true
      color: "$ink"
      text: "Gravitational wave"

  # GW incoming wave
  - elementId: gw-wave
    elementType: line
    bounds: [205, 95, 55, 60]
    points: "0,0 12,18 8,32 30,45 45,55"
    curve: round
    arrow: [null, triangle]
    border: { style: solid, width: 2, color: "$primary" }

  # Polarization icons
  - elementId: gw-pol-plus
    elementType: shape
    shapeName: ellipse
    bounds: [215, 160, 18, 18]
    fill: { type: solid, color: "$highlightBg" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: gw-pol-plus-txt
    elementType: text
    bounds: [238, 160, 30, 18]
    content:
      fontSize: 9
      color: "$ink"
      text: |
        \( h_+ \)

  - elementId: gw-pol-cross
    elementType: shape
    shapeName: ellipse
    bounds: [215, 182, 18, 18]
    fill: { type: solid, color: "$highlightBg" }
    border: { style: solid, width: 1, color: "$primary" }

  - elementId: gw-pol-cross-txt
    elementType: text
    bounds: [238, 182, 30, 18]
    content:
      fontSize: 9
      color: "$ink"
      text: |
        \( h_\times \)

  # Laser Box
  - elementId: laser-box
    elementType: shape
    shapeName: rect
    bounds: [200, 225, 65, 34]
    fill: { type: solid, color: "$cardBg" }
    border: { style: solid, width: 1.5, color: "$ink" }

  - elementId: laser-text
    elementType: text
    bounds: [200, 227, 65, 30]
    content:
      align: [center, middle]
      fontSize: 9
      bold: true
      color: "$ink"
      text: "Laser\n(1064 nm)"

  # Power Recycling Mirror
  - elementId: prm-mirror
    elementType: shape
    shapeName: rect
    bounds: [282, 236, 6, 14]
    fill: { type: solid, color: "$ink" }

  - elementId: prm-label
    elementType: text
    bounds: [248, 258, 80, 24]
    content:
      align: [center, top]
      fontSize: 8
      color: "$muted"
      text: "Power-recycling\nmirror"

  # Laser beam from Laser to Beam Splitter
  - elementId: beam-input
    elementType: line
    bounds: [265, 242, 60, 2]
    points: "0,0 60,0"
    border: { style: solid, width: 2, color: "$teal" }

  # Beam Splitter (45 deg Diamond)
  - elementId: beam-splitter
    elementType: shape
    shapeName: diamond
    bounds: [320, 232, 22, 22]
    fill: { type: solid, color: "$teal" }
    border: { style: solid, width: 1.5, color: "$ink" }

  - elementId: bs-label
    elementType: text
    bounds: [265, 212, 75, 16]
    content:
      align: [center, middle]
      fontSize: 8.5
      bold: true
      color: "$ink"
      text: "Beam splitter"

  # Vertical Arm (Input test mass, cavity, End test mass)
  - elementId: itm-y
    elementType: shape
    shapeName: rect
    bounds: [324, 198, 14, 6]
    fill: { type: solid, color: "$ink" }

  - elementId: etm-y
    elementType: shape
    shapeName: rect
    bounds: [322, 88, 18, 8]
    fill: { type: solid, color: "$ink" }

  - elementId: beam-y-up
    elementType: line
    bounds: [328, 96, 2, 102]
    points: "0,0 0,102"
    border: { style: solid, width: 2, color: "$teal" }

  - elementId: beam-y-down
    elementType: line
    bounds: [332, 96, 2, 102]
    points: "0,0 0,102"
    border: { style: solid, width: 2, color: "$teal" }

  - elementId: label-4km-y
    elementType: text
    bounds: [302, 135, 20, 30]
    content:
      fontSize: 8.5
      color: "$muted"
      text: "4 km"

  # Horizontal Arm (Input test mass, cavity, End test mass)
  - elementId: itm-x
