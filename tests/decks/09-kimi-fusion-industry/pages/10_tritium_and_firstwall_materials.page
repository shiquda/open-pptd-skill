        <p>2026–2030</p>

  - elementId: watch-1
    elementType: text
    bounds: [190, 398, 250, 46]
    content:
      fontSize: 7.5
      color: "$ink"
      lineHeight: 1.3
      text: |
        <p><b>TBR measured on hardware</b></p>
        <p>Target 1.05–1.15; no integrated breeding loop has yet been operated</p>

  - elementId: watch-2
