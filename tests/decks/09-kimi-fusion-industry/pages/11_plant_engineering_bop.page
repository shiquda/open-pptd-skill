    bounds: [50, 518, 620, 15]
    content:
      style: "$caption"
      text: "Source: UKAEA MAST-U Divertor Results (2023); Electric Power Research Institute (EPRI) Fusion BOP Technical Assessment (2024)."

  # Footer Page Right
  - elementId: footer-page
