background: { type: solid, color: "$paper" }
notes: |
  本页通过时序图展示一笔核心下单交易从客户端发起、经过网关路由、单元内执行到跨单元异步同步的全过程。
  如图所示，步骤 1 到步骤 6 构成了用户的同步下单主链路：
  网关解析 UID 后直接分发给上海本地单元，在单元内部完成扣款与落盘，并在 12.3 毫秒内直接返回客户端 HTTP 200 成功响应。
  而步骤 7 与步骤 8 是通过 DTS 进行的异地异步数据复制（采用隐形战机虚线箭头标出），跨省光纤传输在后台进行，完全脱离了同步调用路径。
  这种设计确保了即便沪深专线发生 100 毫秒的剧烈网络抖动，用户的下单延迟与成功率也丝毫不受干扰。
elements:
  # Header
  - elementId: sec-tag
    elementType: text
    bounds: [45, 24, 400, 14]
    content:
      text: "07 / 交易链路时序交互 | SEQUENCE INTERACTION DIAGRAM"
      fontSize: 8.5
      bold: true
      color: "$active"

  - elementId: main-title
    elementType: text
    bounds: [45, 38, 870, 26]
    content:
      text: "单元内微秒级就地提交保证低延迟，跨单元异步解耦避免阻塞用户下单路径"
      fontSize: 16
      bold: true
      color: "$ink"

  - elementId: header-line
    elementType: line
    bounds: [45, 68, 870, 1]
    points: "0,0 870,0"
    border: { style: solid, width: 1, color: "$hairline" }

  # ==========================================
  # Column Headers (6 Roles)
  # ==========================================
  # Col 1: Client
  - elementId: col1-box
    elementType: shape
    shapeName: rect
    bounds: [55, 76, 110, 28]
    fill: { type: solid, color: "$surfaceMuted" }
    border: { style: solid, width: 0.75, color: "$borderDark" }

  - elementId: col1-text
    elementType: text
    bounds: [55, 82, 110, 16]
    content:
      text: "客户端 Client"
      fontSize: 8.5
      bold: true
      align: [center, middle]
      color: "$ink"

  - elementId: col1-line
    elementType: line
    bounds: [110, 104, 1, 355]
    points: "0,0 0,355"
    border: { style: dash, width: 1, color: "$hairline" }

  # Col 2: Anycast Gateway
  - elementId: col2-box
    elementType: shape
    shapeName: rect
    bounds: [195, 76, 110, 28]
    fill: { type: solid, color: "$surfaceMuted" }
    border: { style: solid, width: 0.75, color: "$borderDark" }

  - elementId: col2-text
    elementType: text
    bounds: [195, 82, 110, 16]
    content:
      text: "Anycast 智能网关"
      fontSize: 8.5
      bold: true
      align: [center, middle]
      color: "$ink"

  - elementId: col2-line
    elementType: line
    bounds: [250, 104, 1, 355]
    points: "0,0 0,355"
    border: { style: dash, width: 1, color: "$hairline" }

  # Col 3: Cell Ingress
  - elementId: col3-box
    elementType: shape
    shapeName: rect
    bounds: [335, 76, 110, 28]
    fill: { type: solid, color: "$surfaceMuted" }
    border: { style: solid, width: 0.75, color: "$borderDark" }

  - elementId: col3-text
    elementType: text
    bounds: [335, 82, 110, 16]
    content:
      text: "Cell 单元网关"
      fontSize: 8.5
      bold: true
      align: [center, middle]
      color: "$ink"

  - elementId: col3-line
    elementType: line
    bounds: [390, 104, 1, 355]
    points: "0,0 0,355"
    border: { style: dash, width: 1, color: "$hairline" }

  # Col 4: Trade Core
  - elementId: col4-box
    elementType: shape
    shapeName: rect
    bounds: [475, 76, 110, 28]
    fill: { type: solid, color: "$surfaceMuted" }
    border: { style: solid, width: 0.75, color: "$borderDark" }

  - elementId: col4-text
    elementType: text
    bounds: [475, 82, 110, 16]
    content:
      text: "交易核心 TradeCore"
      fontSize: 8.5
      bold: true
      align: [center, middle]
      color: "$ink"

  - elementId: col4-line
    elementType: line
    bounds: [530, 104, 1, 355]
    points: "0,0 0,355"
    border: { style: dash, width: 1, color: "$hairline" }

  # Col 5: Local DB
  - elementId: col5-box
    elementType: shape
    shapeName: rect
    bounds: [615, 76, 110, 28]
    fill: { type: solid, color: "$surfaceMuted" }
    border: { style: solid, width: 0.75, color: "$borderDark" }

  - elementId: col5-text
    elementType: text
    bounds: [615, 82, 110, 16]
    content:
      text: "本地分片库 LocalDB"
      fontSize: 8.5
      bold: true
      align: [center, middle]
      color: "$ink"

  - elementId: col5-line
    elementType: line
    bounds: [670, 104, 1, 355]
    points: "0,0 0,355"
    border: { style: dash, width: 1, color: "$hairline" }

  # Col 6: Inter-Cell DTS
  - elementId: col6-box
    elementType: shape
    shapeName: rect
    bounds: [755, 76, 125, 28]
    fill: { type: solid, color: "$surfaceMuted" }
    border: { style: solid, width: 0.75, color: "$borderDark" }

  - elementId: col6-text
    elementType: text
    bounds: [755, 82, 125, 16]
    content:
      text: "跨单元 DTS (SZ01)"
      fontSize: 8.5
      bold: true
      align: [center, middle]
      color: "$sync"

  - elementId: col6-line
    elementType: line
    bounds: [817, 104, 1, 355]
    points: "0,0 0,355"
    border: { style: dash, width: 1, color: "$hairline" }

  # ==========================================
  # Message Flow
  # ==========================================
  # Message 1: Client -> Anycast GW
  - elementId: msg1-line
    elementType: line
    bounds: [110, 130, 140, 1]
    points: "0,0 140,0"
    arrow: [null, triangle]
    border: { style: solid, width: 1.5, color: "$active" }

  - elementId: msg1-lbl
    elementType: text
    bounds: [115, 114, 135, 14]
    content:
      text: "1. POST /order/create (UID=210)"
      fontSize: 7.5
      color: "$active"

  # Message 2: Anycast GW -> Cell Ingress
  - elementId: msg2-line
    elementType: line
    bounds: [250, 165, 140, 1]
    points: "0,0 140,0"
    arrow: [null, triangle]
    border: { style: solid, width: 1.5, color: "$active" }

  - elementId: msg2-lbl
    elementType: text
    bounds: [255, 149, 135, 14]
    content:
      text: "2. UID%1024=210 → 路由至 Cell-SH01"
      fontSize: 7.5
      color: "$active"

  # Message 3: Cell Ingress -> Trade Core
  - elementId: msg3-line
    elementType: line
    bounds: [390, 200, 140, 1]
    points: "0,0 140,0"
    arrow: [null, triangle]
    border: { style: solid, width: 1.5, color: "$active" }

  - elementId: msg3-lbl
    elementType: text
    bounds: [395, 184, 135, 14]
    content:
      text: "3. RPC 调用 (单元内 mTLS 0.5ms)"
      fontSize: 7.5
      color: "$active"

  # Message 4: Trade Core -> Local DB
  - elementId: msg4-line
    elementType: line
    bounds: [530, 235, 140, 1]
    points: "0,0 140,0"
    arrow: [null, triangle]
    border: { style: solid, width: 1.5, color: "$active" }

  - elementId: msg4-lbl
    elementType: text
    bounds: [535, 219, 135, 14]
    content:
      text: "4. Begin Tx: 扣减额度 & 刷写 WAL"
      fontSize: 7.5
      color: "$active"

  # Message 5: Local DB -> Trade Core
  - elementId: msg5-line
    elementType: line
    bounds: [530, 270, 140, 1]
    points: "140,0 0,0"
    arrow: [null, triangle]
    border: { style: solid, width: 1.5, color: "$sync" }

  - elementId: msg5-lbl
    elementType: text
    bounds: [535, 254, 135, 14]
    content:
      text: "5. Commit 成功响应 (耗时 3.8ms)"
      fontSize: 7.5
      color: "$sync"

  # Message 6: Trade Core -> Client App (End-to-End Success)
  - elementId: msg6-line
    elementType: line
    bounds: [110, 310, 420, 1]
    points: "420,0 0,0"
    arrow: [null, triangle]
    border: { style: solid, width: 1.5, color: "$sync" }

  - elementId: msg6-lbl
    elementType: text
    bounds: [115, 294, 300, 14]
    content:
      text: "6. HTTP 200 OK: 下单成功确认回包 (端到端 P95 < 28ms)"
      fontSize: 7.5
      bold: true
      color: "$sync"

  # Message 7: Local DB -> Inter-Cell DTS (Async Step)
  - elementId: msg7-line
    elementType: line
    bounds: [670, 360, 147, 1]
    points: "0,0 147,0"
    arrow: [null, stealth]
    border: { style: dash, width: 1.5, color: "$sync" }

  - elementId: msg7-lbl
    elementType: text
    bounds: [675, 344, 140, 14]
    content:
      text: "7. 异步 Binlog Dump 批量解析抓取"
      fontSize: 7.5
      color: "$sync"

  # Message 8: Inter-Cell DTS Replay to Remote Standby
  - elementId: msg8-line
    elementType: line
    bounds: [817, 395, 80, 25]
    points: "0,0 70,0 70,25 0,25"
    arrow: [null, stealth]
    border: { style: dash, width: 1.5, color: "$sync" }

  - elementId: msg8-lbl
    elementType: text
    bounds: [675, 385, 140, 28]
    content:
      text: "8. 专线异步同步至深圳从库\n(物理延迟 36ms, 后台解耦)"
      fontSize: 7.2
      color: "$sync"

  # Bottom Explanation Box
  - elementId: seq-summary-box
    elementType: shape
    shapeName: rect
    bounds: [55, 435, 825, 62]
    fill: { type: solid, color: "$surface" }
    border: { style: solid, width: 0.75, color: "$hairline" }

  - elementId: seq-summary-text
    elementType: text
    bounds: [65, 440, 805, 52]
    content:
      text: |
        【关键机制说明】：
        • 同步下单主链路（步骤 1~6）全程在上海 Cell-SH01 单元内自闭环运行，无任何跨城 RPC 调用，核心事务在 4.5ms 内落盘完成。
        • 异地数据复制（步骤 7~8）完全采用异步事件驱动，由 DTS 捕获 Binlog 增量批量分发；专线网络抖动完全隔离在后台，不影响用户主链路。
      fontSize: 8.2
      lineHeight: 1.35
      color: "$ink"

  # Footer
  - elementId: footer-line
    elementType: line
    bounds: [45, 510, 870, 1]
    points: "0,0 870,0"
    border: { style: solid, width: 1, color: "$hairline" }

  - elementId: footer-meta
    elementType: text
    bounds: [45, 516, 500, 16]
    content:
      text: "交易核心多活架构评审 | 核心交易链路时序交互 | 2026-10-20"
      fontSize: 8.5
      color: "$muted"

  - elementId: footer-page
    elementType: text
    bounds: [840, 516, 75, 16]
    content:
      text: "PAGE 07 / 10"
      fontSize: 8.5
      color: "$muted"
      align: [right, top]
